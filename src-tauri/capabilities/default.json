{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-confirm",
    "allow-check-code-server",
    "allow-start-project",
    "allow-stop-project",
    "allow-load-projects",
    "allow-save-projects",
    "allow-read-image-as-data-url",
    "allow-open-in-vscode",
    "allow-reveal-terminal",
    "allow-toggle-vscode-sidebar",
    "allow-set-vscode-theme"
  ],
  "remote": {
    "urls": [
      "http://localhost:*"
    ]
  }
}
